node_modules/
.DS_Store
dist/
coverage/
tmp/

# Cloudflare Pages deploy output, assembled by scripts/assemble_pages_output.js
.pages-output/

# Build output. `npm run distribution:prepare` regenerates it immediately
# before every consumer (validate:release) in all three workflows that read
# it, and the self-heal registry declares it as the repair command.
.build/

# collect_index_coverage.py imports collect_gsc_export.py; the daily cycle commits
# with `git add -A`, so bytecode caches must never be picked up.
__pycache__/
*.pyc

# wrangler pages dev / local D1 state for the /admin console (npm run admin:dev).
.wrangler/
.dev.vars
