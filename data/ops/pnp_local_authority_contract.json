{
  "contract": "PNP_LOCAL_AUTHORITY_CONTRACT",
  "version": "2026-07-24",
  "repo": "p-n-p-main",
  "brand": "Porch & Party",
  "primary_domain": "https://porchandparty901.com",
  "operating_entity": "Kerseta LLC",
  "public_contact_email": "hello@porchandparty901.com",
  "site_type": "static_local_service_authority_site",
  "source_of_truth": {
    "query_universe": "data/queries/query_universe.json",
    "publish_queue": "data/publish_queue/publish_queue.json",
    "published_manifest": "data/published_manifest/published_manifest.json",
    "slug_registry": "data/slug_registry/slug_registry.json",
    "service_matrix": "data/local_matrix/service_city_occasion_matrix.json",
    "offers": "data/offers/services.json",
    "service_areas": "data/service_areas/areas.json",
    "authority_scale": "data/authority_scale/fanout_100k/index.json",
    "candidate_backlog": "data/authority_scale/candidate_backlog.json",
    "admission_registry": "data/content/page_admission_registry.json",
    "freeze_registry": "data/release/frozen_output_registry.json",
    "citation_scoreboard": "data/authority_scale/citation_yield_scoreboard.json",
    "search_intelligence_contract": "data/search_intelligence/search_intelligence_contract.json",
    "search_target_query_set": "data/search_intelligence/target_query_set.json",
    "search_provider_truth": "data/search_intelligence/gsc_truth.json",
    "search_diagnosis": "data/search_intelligence/search_diagnosis.json",
    "search_repair_candidates": "data/search_intelligence/repair_candidates.json"
  },
  "authority_families": [
    "seasonal_porch_decorating",
    "party_decor",
    "hotel_room_decor",
    "grazing_table_styling"
  ],
  "cadence": {
    "daily": [
      "refresh_operational_fanout_window",
      "score_new_vs_existing_page_opportunities",
      "evaluate_evidence_gated_velocity",
      "publish_only_qualified_queued_pages_within_remaining_daily_ceiling",
      "validate_freeze_and_distribution_contracts"
    ],
    "weekly": [
      "review_query_and_page_family_yield",
      "prefer_existing_page_improvement_when_intent_already_covered",
      "review_indexation_distribution_and_citation_evidence"
    ],
    "monthly": [
      "review_top_service_pages_and_faqs",
      "confirm_legal_contact_and_quote_paths",
      "confirm_google_business_profile_services_match_site",
      "decide_expand_tighten_or_retire_pages"
    ],
    "daily_bulk_publishing": false,
    "daily_new_url_ceiling_mode": "evidence_gated_not_quota"
  },
  "queue_contract": {
    "approved_statuses": [
      "queued",
      "published",
      "skipped",
      "retired"
    ],
    "current_expected_mode": "fully_published_queue_until_new_candidates_are_explicitly_enriched_and_queued",
    "published_items_must_have_html": true,
    "published_items_must_be_in_manifest": true,
    "manifest_items_must_have_html": true,
    "query_universe_items_must_be_represented_in_queue": true,
    "empty_unpublished_queue_is_allowed": true
  },
  "self_heal_policy": {
    "validation_may_mutate_files": false,
    "safe_repairs": [
      "restore_missing_manifest_entry_for_existing_published_html",
      "restore_missing_queue_entry_from_query_universe",
      "restore_sitemap_after_explicit_build_sitemap_run",
      "rebuild_authority_scale_planning_artifacts",
      "rebuild_distribution_artifacts"
    ],
    "unsafe_repairs_require_operator_action": [
      "delete_or_retire_public_pages",
      "change_offer_scope_or_pricing",
      "replace_real_project_images",
      "submit_to_external_providers"
    ]
  },
  "external_agent_lane": {
    "enabled": false,
    "reason": "The current PNP source ZIP contains no external AI agent artifact drop lane. Do not invent one. If a future agent lane is added, define raw, normalized, processed, and receipt paths before enabling validation for it."
  },
  "hard_fail_only": [
    "missing_required_static_files",
    "broken_internal_links",
    "malformed_json_or_json_ld",
    "sitemap_drift",
    "missing_legal_footer_or_contact_identity",
    "missing_core_service_family_surfaces",
    "publish_queue_manifest_contract_break",
    "validation_profile_contains_mutating_execution_command",
    "dependency_runtime_or_receipt_pollution_in_artifact",
    "grounded_search_observation_represented_as_literal_serp_rank",
    "own_site_google_performance_asserted_without_search_console_basis",
    "degraded_or_unavailable_provider_reported_as_green",
    "search_intelligence_lane_mutates_publishing_state_or_cadence",
    "search_observation_exceeds_declared_free_provider_allowance"
  ],
  "warning_or_info_only": [
    "subjective_copy_quality",
    "visual_polish",
    "offsite_distribution_strength",
    "google_business_profile_strength",
    "empty_unpublished_queue_when_all_known_items_are_published"
  ],
  "authority_scale": {
    "objective": "maximize_probability_of_100k_verified_external_citations_within_180_days_or_less_as_a_stretch_target_not_a_guarantee",
    "fanout_reference_runway": 100000,
    "fanout_is_page_quota": false,
    "twin_agent_enabled": false,
    "twin_scope_note": "Twin Agent exists only in Velocity and Spry. P-n-P uses generalized page-quality lessons only.",
    "starting_new_url_ceiling_per_day": 3,
    "scale_tiers": [
      3,
      5,
      10,
      15,
      25,
      50
    ],
    "unified_new_url_budget": true,
    "improve_before_duplicate_new_url": true,
    "service_area_truth_source": "data/service_areas/areas.json"
  },
  "search_intelligence": {
    "enabled": true,
    "contract": "data/search_intelligence/search_intelligence_contract.json",
    "lane_mode": "READ_AND_PREPARE_ONLY",
    "own_site_google_performance_authority": "google_search_console",
    "grounded_observation_is_literal_serp_rank": false,
    "publishes": false,
    "mutates_publishing_cadence": false,
    "included_in_authority_cycle": false,
    "writable_paths": [
      "data/search_intelligence/",
      "data/authority_scale/observed_surfacing_ledger.json",
      "data/authority_scale/citation_yield_observations.json"
    ],
    "provider_truth_note": "Provider unavailable or degraded state is reported as UNAVAILABLE/DEGRADED with evidence. It never produces a green or OK result, and zero findings never means healthy.",
    "release_validator": "npm run validate:search-intelligence",
    "proof_commands": [
      "npm run search:selftest",
      "npm run search:selftest:loop"
    ]
  }
}
