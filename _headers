/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Cloudflare Pages is serving this project from the repository root, so files
# tracked in git are publicly reachable (README.md, AGENTS.md and package.json
# all return 200). Markdown sources that duplicate published HTML are the
# WO-15 duplicate-content risk; the rest is internal governance and build
# config that should not be in an index.
#
# robots.txt allows everything here, so noindex is served as a header:
# disallowing the paths would stop crawlers reading the directive and leave
# anything already indexed in place.
/*.md
  X-Robots-Tag: noindex, nofollow

/package.json
  X-Robots-Tag: noindex, nofollow

/package-lock.json
  X-Robots-Tag: noindex, nofollow

# Stylesheets and scripts are referenced without a version query, so a
# 4-hour browser cache (the Pages default) leaves returning visitors on the
# old CSS after every layout change: /faq/ rendered unstyled for them on
# 17 Oct 2026. The edge still caches; browsers revalidate on each load.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate
