/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# The production Pages host serves the same site as porchandparty901.com and was
# found indexed by a web search (6 Nov 2026). Exactly that host answers noindex;
# its canonicals already name porchandparty901.com. Branch previews
# (<branch>.p-n-p.pages.dev) and the real domain are not matched. A 301 would need
# a root Function in front of every public page, which validate:edge-cache-rule
# forbids; post_deploy_live_check.mjs (9) proves this header live.
https://p-n-p.pages.dev/*
  X-Robots-Tag: noindex

# Cloudflare Pages is serving this project from the repository root, so files
# tracked in git are publicly reachable (README.md, AGENTS.md and package.json
# all return 200). Markdown sources that duplicate published HTML are the
# WO-15 duplicate-content risk; the rest is internal governance and build
# config that should not be in an index.
#
# robots.txt allows everything here, so noindex is served as a header:
# disallowing the paths would stop crawlers reading the directive and leave
# anything already indexed in place.
/*.md
  X-Robots-Tag: noindex, nofollow

/package.json
  X-Robots-Tag: noindex, nofollow

/package-lock.json
  X-Robots-Tag: noindex, nofollow

# Asks browsers to revalidate CSS and JS. On its own this does NOT reach
# visitors: the porchandparty901.com zone's Browser Cache TTL rewrites it to
# max-age=14400 (p-n-p.pages.dev serves it unchanged). The working fix is the
# ?v=<content hash> that scripts/assemble_pages_output.js stamps on every
# stylesheet and script URL in the published HTML.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate
